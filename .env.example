# ==============================================================================
# CampusHire — Environment Configuration Template
# Copy this file to .env before starting the services
# NEVER commit the real .env to version control
# ==============================================================================

# Application Port & Mode
PORT=4000
NODE_ENV=production

# MySQL Database Connectivity
DB_HOST=localhost
DB_PORT=3306
DB_USER=campushire_user
DB_PASSWORD=campushire_password
DB_NAME=campushire

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_campushire_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Vite default dev server is 5173)
CLIENT_ORIGIN=http://localhost:5173
